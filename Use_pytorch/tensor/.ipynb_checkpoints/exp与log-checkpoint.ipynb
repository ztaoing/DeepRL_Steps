   "source": [
    "import math\n",
    "\n",
    "# 计算 e 的 2 次幂\n",
    "exp_result = math.exp(2)\n",
    "print(\"e^2 =\", exp_result)\n",
    "\n",
    "# 计算自然对数\n",
    "log_result = math.log(exp_result)\n",
    "print(\"ln(e^2) =\", log_result)"
   ]
